# Copy this file to .env before starting local infrastructure. These values are
# development defaults only; use unique credentials in shared environments.
RAG_EVAL_ENVIRONMENT=development

RAG_EVAL_POSTGRES_HOST=localhost
RAG_EVAL_POSTGRES_PORT=5433
RAG_EVAL_POSTGRES_DATABASE=rag_eval
RAG_EVAL_POSTGRES_USER=rag_eval
RAG_EVAL_POSTGRES_PASSWORD=rag_eval

RAG_EVAL_S3_ENDPOINT_URL=http://localhost:9002
RAG_EVAL_S3_ACCESS_KEY=minioadmin
RAG_EVAL_S3_SECRET_KEY=minioadmin
RAG_EVAL_S3_BUCKET=rag-eval-artifacts
RAG_EVAL_S3_REGION=us-east-1
